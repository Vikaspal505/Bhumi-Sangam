rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication Checks
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role Checks
    function hasRole(role) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role) ||
        request.auth.token.role == role
      );
    }

    function isAdmin() {
      return hasRole('System Admin');
    }

    function isRevenueOfficer() {
      return hasRole('Revenue Officer') || isAdmin();
    }

    function isSurveyor() {
      return hasRole('Field Surveyor') || isAdmin();
    }

    function isPublicViewer() {
      return hasRole('Public Viewer');
    }

    // 1. Users Directory:
    // Only signed-in users can read, only Admins can create/update/delete.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 2. Finalized Parcels & Datasets:
    // Public Viewers can read. Admins and Revenue Officers can write/update.
    match /parcels/{parcelId} {
      allow read: if isPublicViewer() || isSignedIn();
      allow write: if isRevenueOfficer();
    }

    match /datasets/{datasetId} {
      allow read: if isPublicViewer() || isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Cadastral Workflows & Pipeline:
    // Private to active staff. Public Viewers have NO access.
    match /pipelineRuns/{runId} {
      allow read: if isRevenueOfficer() || isSurveyor();
      allow write: if isRevenueOfficer();
    }

    // 4. Disputes & Mutations:
    // Only Revenue Officers (and Admins) can read/write.
    match /conflicts/{conflictId} {
      allow read, write: if isRevenueOfficer();
    }

    match /approvals/{approvalId} {
      allow read, write: if isRevenueOfficer();
    }

    // 5. Field Ground-Truthing & Topology Tasks:
    // Surveyors can write/update. Officers can read/assign.
    match /surveyTasks/{taskId} {
      allow read: if isSurveyor() || isRevenueOfficer();
      allow create: if isRevenueOfficer();
      allow update: if isSurveyor() || isRevenueOfficer();
      allow delete: if isAdmin();
    }

    match /gnssPoints/{pointId} {
      allow read: if isSurveyor() || isRevenueOfficer();
      allow write: if isSurveyor();
    }

    // 6. Audit Logs:
    // Read-only for admins. Append-only for all logged-in staff. No delete.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable
    }

    // 7. Issue Reports:
    // Public can create. Staff can read/update.
    match /issueReports/{reportId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if isRevenueOfficer();
    }

    // 8. Personal Chat History
    match /chatHistory/{userId}/messages/{messageId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 9. Default catch-all (Secure by Default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
